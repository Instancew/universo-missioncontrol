# Low-bitrate field-test starting profile; confirm camera modes with v4l2-ctl.
VIDEO_DEVICE=/dev/video0
CAMERA_FORMAT=raw
SOURCE=camera
ENCODER=auto
WIDTH=640
HEIGHT=360
FPS=15
BITRATE_KBPS=700
KEYFRAME_SECONDS=1
# Stable Jetson service address; same on both transit routes.
MTX_WEBRTCADDITIONALHOSTS=10.42.0.10
MTX_WEBRTCALLOWORIGINS=http://10.43.0.10:5173
